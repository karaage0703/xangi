#!/bin/sh
# Compatibility shim. The canonical interface is: xangi tool <operation>.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

# Managed bundles contain their own Node runtime but no globally available Node.
if [ -x "$ROOT_DIR/runtime/bin/node" ] && [ -f "$ROOT_DIR/dist/cli/xangi-main.js" ]; then
  exec "$ROOT_DIR/runtime/bin/node" "$ROOT_DIR/dist/cli/xangi-main.js" tool "$@"
fi

exec "$SCRIPT_DIR/xangi" tool "$@"
