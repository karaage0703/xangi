{
  "name": "xangi-dev",
  "version": "0.1.0",
  "description": "AI assistant connecting agent backends to Discord, Slack, Telegram, Web Chat, and LINE",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xangi": "./bin/xangi",
    "xangi-cmd": "./bin/xangi-cmd"
  },
  "scripts": {
    "build": "tsc && vite build",
    "build:web": "vite build",
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ web-ui/src/ vite.config.ts",
    "lint:fix": "eslint src/ web-ui/src/ vite.config.ts --fix",
    "format": "prettier --write src/ web-ui/src/ vite.config.ts",
    "format:check": "prettier --check src/ web-ui/src/ vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web-ui/tsconfig.json",
    "xangi": "node dist/cli/xangi-main.js",
    "xangi-cmd": "node --env-file=.env dist/cli/xangi-cmd.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,web-ui/src}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src,tests,web-ui/src}/**/*.{ts,tsx}": [
      "bash -c 'unset DATA_DIR WORKSPACE_PATH GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE; npx vitest run'",
      "bash -c 'npx tsc --noEmit'"
    ]
  },
  "keywords": [
    "ai",
    "agent",
    "discord",
    "claude-code"
  ],
  "author": "karaage",
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11",
    "@line/bot-sdk": "^11.2.0",
    "@octokit/auth-app": "^8.3.0",
    "@slack/bolt": "^4.7.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "node-cron": "^4.6.0",
    "proper-lockfile": "^4.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slackify-markdown": "^5.0.0",
    "undici": "6.28.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
